@* Hand-rolled SVG line chart: enough for one series with a limit line, no chart library needed. *@

<svg class="trend @(Compact ? "trend--compact" : "")" viewBox="0 0 @Width @Height" role="img" aria-label="@Label">
    @* SVG <text> has to sit inside <g>: on its own in a code block Razor reads it as its own <text> tag. *@
    @if (!Compact)
    {
        <g class="trend__axes">
            @foreach (var tick in _ticks)
            {
                <line class="trend__grid" x1="@F(PadLeft)" x2="@F(Width - PadRight)" y1="@F(Y(tick))" y2="@F(Y(tick))" />
            }
            @foreach (var tick in _ticks)
            {
                <g><text class="trend__axis" x="@F(PadLeft - 6)" y="@F(Y(tick) + 4)" text-anchor="end">@tick.ToString(TickFormat, CultureInfo.InvariantCulture)</text></g>
            }
            <text class="trend__axis" x="@F(PadLeft)" y="@F(Height - 4)">@_start.ToLocalTime().ToString("HH:mm")</text>
            <text class="trend__axis" x="@F(Width - PadRight)" y="@F(Height - 4)" text-anchor="end">@_end.ToLocalTime().ToString("HH:mm:ss")</text>
        </g>
    }

    @if (Limit is { } limit)
    {
        <g class="trend__limit-group">
            <line class="trend__limit" x1="@F(PadLeft)" x2="@F(Width - PadRight)" y1="@F(Y(limit))" y2="@F(Y(limit))" />
            @if (!Compact)
            {
                <g><text class="trend__limit-label" x="@F(Width - PadRight - 4)" y="@F(Y(limit) - 5)" text-anchor="end">limit @limit.ToString(TickFormat, CultureInfo.InvariantCulture) @Unit</text></g>
            }
        </g>
    }

    @if (_path.Length > 0)
    {
        <path class="trend__line" d="@_path" />
    }
    else if (!Compact)
    {
        <g><text class="trend__empty" x="@F(Width / 2)" y="@F(Height / 2)" text-anchor="middle">Waiting for data…</text></g>
    }
</svg>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<(DateTimeOffset At, double Value)> Points { get; set; } = [];
    [Parameter] public TimeSpan Window { get; set; } = TimeSpan.FromMinutes(15);
    [Parameter] public double? Limit { get; set; }
    [Parameter] public string Unit { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string TickFormat { get; set; } = "0";
    [Parameter] public bool Compact { get; set; }

    // A gap longer than this means the machine was offline; the line breaks instead of bridging it.
    private static readonly TimeSpan MaxGap = TimeSpan.FromSeconds(5);

    private double Width => Compact ? 240 : 640;
    private double Height => Compact ? 56 : 200;
    private double PadLeft => Compact ? 2 : 44;
    private double PadRight => Compact ? 2 : 8;
    private double PadTop => Compact ? 4 : 12;
    private double PadBottom => Compact ? 4 : 22;

    private DateTimeOffset _start;
    private DateTimeOffset _end;
    private double _min;
    private double _max;
    private string _path = "";
    private double[] _ticks = [];

    protected override void OnParametersSet()
    {
        // The newest point is the right edge, so a skewed browser clock does not shift the chart.
        _end = Points.Count > 0 ? Points[^1].At : DateTimeOffset.UtcNow;
        _start = _end - Window;

        var visible = Points.Where(p => p.At >= _start).ToList();
        var values = visible.Select(p => p.Value).ToList();
        if (Limit is { } limit)
            values.Add(limit);

        var low = values.Count > 0 ? values.Min() : 0;
        var high = values.Count > 0 ? values.Max() : 1;
        var step = NiceStep(Math.Max(high - low, 1) / 3);

        // Snap the range to whole steps so the gridlines land on round numbers.
        _min = Math.Floor(low / step) * step;
        _max = Math.Ceiling(high / step) * step;
        if (_max - _min < step * 2)
            _max = _min + step * 2;

        _ticks = Enumerable.Range(0, (int)Math.Round((_max - _min) / step) + 1)
            .Select(i => _min + i * step)
            .ToArray();
        _path = BuildPath(visible);
    }

    private static double NiceStep(double rough)
    {
        var magnitude = Math.Pow(10, Math.Floor(Math.Log10(rough)));
        var fraction = rough / magnitude;
        var nice = fraction <= 1 ? 1 : fraction <= 2 ? 2 : fraction <= 5 ? 5 : 10;
        return nice * magnitude;
    }

    private string BuildPath(List<(DateTimeOffset At, double Value)> points)
    {
        var path = new System.Text.StringBuilder();
        DateTimeOffset? previous = null;

        foreach (var (at, value) in points)
        {
            var command = previous is null || at - previous > MaxGap ? 'M' : 'L';
            path.Append(command).Append(F(X(at))).Append(',').Append(F(Y(value))).Append(' ');
            previous = at;
        }

        return path.ToString().TrimEnd();
    }

    private double X(DateTimeOffset at) =>
        PadLeft + (at - _start) / Window * (Width - PadLeft - PadRight);

    private double Y(double value) =>
        PadTop + (1 - (value - _min) / (_max - _min)) * (Height - PadTop - PadBottom);

    private static string F(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);
}
