@using Microsoft.AspNetCore.SignalR.Client
@inherits LayoutComponentBase
@implements IDisposable
@inject TelemetryFeed Feed

<header class="topbar">
    <a class="brand" href="">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12h4l3-7 4 14 3-7h6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        LineWatch
    </a>
    <nav>
        <NavLink href="" Match="NavLinkMatch.All">Overview</NavLink>
        <NavLink href="alarms">
            Alarms
            @if (Feed.OpenUnacknowledged > 0)
            {
                <span class="count">@Feed.OpenUnacknowledged</span>
            }
        </NavLink>
    </nav>
    <span class="connection connection--@Feed.Connection.ToString().ToLowerInvariant()" title="Connection to the telemetry hub">
        @ConnectionText
    </span>
</header>

<main class="content">
    @Body
</main>

@code {
    private string ConnectionText => Feed.Connection switch
    {
        HubConnectionState.Connected => "Live",
        HubConnectionState.Connecting => "Connecting",
        HubConnectionState.Reconnecting => "Reconnecting",
        _ => "Offline",
    };

    protected override void OnInitialized() => Feed.Changed += OnFeedChanged;

    private void OnFeedChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Feed.Changed -= OnFeedChanged;
}
