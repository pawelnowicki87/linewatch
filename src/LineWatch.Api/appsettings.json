{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "FluentModbus": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LineWatch": "Host=localhost;Port=5434;Database=linewatch;Username=linewatch;Password=linewatch"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5081" ]
  },
  "ReadingRetentionHours": 24,
  "Collector": {
    "PollIntervalMilliseconds": 1000,
    "TimeoutMilliseconds": 800,
    "FailedPollsBeforeOffline": 3,
    "Machines": [
      { "Id": "mill-1", "Name": "CNC mill 1", "Host": "localhost", "Port": 5020, "UnitId": 1, "MaxTemperatureC": 80, "HysteresisC": 3 },
      { "Id": "mill-2", "Name": "CNC mill 2", "Host": "localhost", "Port": 5020, "UnitId": 2, "MaxTemperatureC": 80, "HysteresisC": 3 },
      { "Id": "press-1", "Name": "Hydraulic press", "Host": "localhost", "Port": 5020, "UnitId": 3, "MaxTemperatureC": 62, "HysteresisC": 2 },
      { "Id": "oven-1", "Name": "Curing oven", "Host": "localhost", "Port": 5020, "UnitId": 4, "MaxTemperatureC": 200, "HysteresisC": 5 }
    ]
  }
}
