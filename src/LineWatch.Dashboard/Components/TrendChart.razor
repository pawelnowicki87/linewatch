@*
    Line chart for one series with an optional limit. The plot is an SVG stretched to whatever box it gets
    (preserveAspectRatio="none"), and the labels are plain HTML positioned in percent, so text never
    scales with the chart and the same component works on a phone and on a wall screen.
*@

<div class="trend @(Compact ? "trend--compact" : "")" role="img" aria-label="@Label">
    @if (!Compact)
    {
        <div class="trend__y-axis" aria-hidden="true">
            @foreach (var tick in _ticks)
            {
                <span style="top: @Pct(Y(tick))%">@tick.ToString(TickFormat, CultureInfo.InvariantCulture)</span>
            }
        </div>
    }

    <div class="trend__plot">
        <svg viewBox="0 0 @Size @Size" preserveAspectRatio="none" aria-hidden="true">
            @if (!Compact)
            {
                @foreach (var tick in _ticks)
                {
                    <line class="trend__grid" x1="0" x2="@Size" y1="@F(Y(tick))" y2="@F(Y(tick))" />
                }
            }
            @if (Limit is { } limit)
            {
                <line class="trend__limit" x1="0" x2="@Size" y1="@F(Y(limit))" y2="@F(Y(limit))" />
            }
            @if (_path.Length > 0)
            {
                <path class="trend__line" d="@_path" />
            }
        </svg>

        @if (!Compact && Limit is { } shownLimit)
        {
            <span class="trend__limit-label @(Y(shownLimit) < Size * 0.12 ? "is-below" : null)" style="top: @Pct(Y(shownLimit))%">
                limit @shownLimit.ToString(TickFormat, CultureInfo.InvariantCulture) @Unit
            </span>
        }
        @if (!Compact && _path.Length == 0)
        {
            <span class="trend__empty">Waiting for data…</span>
        }
    </div>

    @if (!Compact)
    {
        <div class="trend__x-axis" aria-hidden="true">
            <span>@_start.ToLocalTime().ToString("HH:mm")</span>
            <span>@_end.ToLocalTime().ToString("HH:mm:ss")</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<(DateTimeOffset At, double Value)> Points { get; set; } = [];
    [Parameter] public TimeSpan Window { get; set; } = TimeSpan.FromMinutes(15);
    [Parameter] public double? Limit { get; set; }
    [Parameter] public string Unit { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string TickFormat { get; set; } = "0";
    [Parameter] public bool Compact { get; set; }

    private const double Size = 1000;
    // Keeps the line off the very top and bottom edge, where half of its stroke would be cut off.
    private const double Inset = 20;

    // A gap longer than this means the machine was offline; the line breaks instead of bridging it.
    private static readonly TimeSpan MaxGap = TimeSpan.FromSeconds(5);

    private DateTimeOffset _start;
    private DateTimeOffset _end;
    private double _min;
    private double _max;
    private string _path = "";
    private double[] _ticks = [];

    protected override void OnParametersSet()
    {
        // The newest point is the right edge, so a skewed browser clock does not shift the chart.
        _end = Points.Count > 0 ? Points[^1].At : DateTimeOffset.UtcNow;
        _start = _end - Window;

        var visible = Points.Where(p => p.At >= _start).ToList();
        var values = visible.Select(p => p.Value).ToList();
        if (Limit is { } limit)
            values.Add(limit);

        var low = values.Count > 0 ? values.Min() : 0;
        var high = values.Count > 0 ? values.Max() : 1;
        var step = NiceStep(Math.Max(high - low, 1) / 3);

        // Snap the range to whole steps so the gridlines land on round numbers.
        _min = Math.Floor(low / step) * step;
        _max = Math.Ceiling(high / step) * step;
        if (_max - _min < step * 2)
            _max = _min + step * 2;

        _ticks = Enumerable.Range(0, (int)Math.Round((_max - _min) / step) + 1)
            .Select(i => _min + i * step)
            .ToArray();
        _path = BuildPath(visible);
    }

    private static double NiceStep(double rough)
    {
        var magnitude = Math.Pow(10, Math.Floor(Math.Log10(rough)));
        var fraction = rough / magnitude;
        var nice = fraction <= 1 ? 1 : fraction <= 2 ? 2 : fraction <= 5 ? 5 : 10;
        return nice * magnitude;
    }

    private string BuildPath(List<(DateTimeOffset At, double Value)> points)
    {
        var path = new System.Text.StringBuilder();
        DateTimeOffset? previous = null;

        foreach (var (at, value) in points)
        {
            var command = previous is null || at - previous > MaxGap ? 'M' : 'L';
            path.Append(command).Append(F(X(at))).Append(',').Append(F(Y(value))).Append(' ');
            previous = at;
        }

        return path.ToString().TrimEnd();
    }

    private double X(DateTimeOffset at) => (at - _start) / Window * Size;

    private double Y(double value) => Inset + (1 - (value - _min) / (_max - _min)) * (Size - 2 * Inset);

    private static string Pct(double y) => (y / Size * 100).ToString("0.##", CultureInfo.InvariantCulture);

    private static string F(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);
}
